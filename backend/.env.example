# ---- LLM (Groq) — never commit real keys ----
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_SECONDARY=
# Optional model overrides (must exist in the provider's /models list, otherwise ignored)
GROQ_FAST_MODEL=
GROQ_REASONING_MODEL=
GROQ_VISION_MODEL=

# ---- Database ----
# PostgreSQL local, e.g. postgresql+psycopg://postgres:postgres@localhost:5432/diwana
# Leave empty to use the local SQLite fallback file backend/data/diwana.db
DATABASE_URL=



# ---- HTTP identification ----
# Contact URL or e-mail sent in the User-Agent (required by Wikidata/Wikimedia API policy).
# Leave empty to skip Wikidata (OpenStreetMap is used instead for entry-point coordinates).
HTTP_CONTACT=

# ---- Semantic model ----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Institutional / authorized access (leave empty if not granted) ----
RNE_API_URL=
RNE_API_KEY=
SINDA_API_URL=
SINDA_API_KEY=
META_GRAPH_ACCESS_TOKEN=
META_PAGE_IDS=
TIKTOK_RESEARCH_API_TOKEN=
# Comma-separated e-commerce domains you are authorized to observe (robots.txt is always enforced)
AUTHORIZED_COMMERCE_SITES=

# ---- Sessions ----
# Empty = a random secret is generated once in data/.session_secret
SESSION_SECRET=
SESSION_HOURS=8
